# Mindfries internal-admin — set these in Vercel (officemindfries account) to go live.
# Copy to .env.local for local dev. All server-only; none exposed to the browser.

# Supabase (Project Settings → API). Shared instance with the candidate app.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API Keys). RESEND_FROM must be a verified sending domain.
RESEND_API_KEY=
RESEND_FROM="Aaryan @ Mindfries <hello@mindfries.com>"
# Where waitlist notifications land + reply-to on outbound mail.
NOTIFY_EMAIL=officemindfries@gmail.com

# Protects the daily crawl endpoint. Vercel Cron sends this as a Bearer token.
CRON_SECRET=
# Optional: gate the Resend engagement webhook (?token=...).
RESEND_WEBHOOK_SECRET=
