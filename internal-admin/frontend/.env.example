# Mindfries internal-admin — set these in Vercel (officemindfries account) to go live.
# Copy to .env.local for local dev. All server-only; none exposed to the browser.

# Supabase (Project Settings → API). Shared instance with the candidate app.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API Keys). RESEND_FROM must be a verified sending domain.
RESEND_API_KEY=
RESEND_FROM="Aaryan @ Mindfries <hello@mindfries.com>"
# Where waitlist notifications land + reply-to on outbound mail.
NOTIFY_EMAIL=officemindfries@gmail.com

# Protects the daily crawl endpoint. Vercel Cron sends this as a Bearer
# token. Both routes fail closed now: unset means the endpoint always
# refuses (401), not that the check is skipped — so the crawl and the
# webhook below are genuinely inert until you set these, not silently open.
CRON_SECRET=
# Gates the Resend engagement webhook (?token=...). No longer optional in
# practice: leave it unset and the webhook route always returns 401.
RESEND_WEBHOOK_SECRET=

# ── Admin sign-in ──────────────────────────────────────────────────────────
# Signs the session cookie. 32+ characters; generate a fresh one per
# environment and never reuse it — a known secret lets anyone mint an admin
# session. Missing it means nobody can sign in, which is the safe direction.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The one account that is always allowed, even when admin_users is empty or
# the table doesn't exist. Everyone else is a row in admin_users, added with
# `npm run admin -- add <email> "<Name>"`.
ROOT_ADMIN_EMAIL=officemindfries@gmail.com
ROOT_ADMIN_PASSWORD=

# Direct Postgres connection, for scripts/migrate.mts and scripts/admin.mts
# only — the app itself never uses it. Supabase dashboard → Project Settings →
# Database → Connection string → URI. Percent-encode any of @ : / ? # [ ] %
# in the password, or the URI will be misparsed.
DATABASE_URL=

# ── Company Portal handoff (IMPLEMENTATION.md §3.6, §6) ─────────────────────
# Where onboarding a company (Companies/Onboarding → "Onboard a company")
# sends the real sign-in link it emails the admin. Unset means that email
# falls back to a generic "we'll be in touch" message rather than a link
# that goes nowhere.
#   Local dev: http://localhost:3002 (or wherever company/frontend runs)
COMPANY_PORTAL_URL=
# Signs that link's one-time token. Must be the EXACT same value as
# company/frontend's own COMPANY_INVITE_SECRET — the one secret deliberately
# shared between the two apps, and only for this handoff. Never reuse
# SESSION_SECRET here. Unset means invites can't be minted at all (the email
# falls back, same as above), not that verification is skipped.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COMPANY_INVITE_SECRET=

# ── candidate/backend (Go, System_Archetect_And_PRD.md §2.3) ───────────────
# Server-only base URL for the Admin API — see lib/backend/client.ts. Unset
# means the Session Monitor's reset/retrigger actions fall back to writing
# directly to Supabase (still real, not sample data — but "retrigger" in
# that fallback only flips a status flag; it doesn't call an evaluation
# agent the way the real backend path does). Set this once the Go backend
# has a real deployment target (task.md's Blocked-on-decision #2) to make
# both support overrides go through the one real implementation.
#   Local dev:  http://localhost:8080
ADMIN_BACKEND_URL=
