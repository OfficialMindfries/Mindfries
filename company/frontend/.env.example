# Mindfries Company Portal — see ARCHITECTURE.md for how this app fits with
# candidate/frontend, internal-admin/frontend, and the two Go backends.

# ── Supabase (shared product database) ───────────────────────────────────────
# Without these, this app falls back to sample data rather than failing — see
# lib/supabase.ts. Service-role key, never the anon key: every read/write here
# runs server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Session signing ──────────────────────────────────────────────────────────
# Signs the "mf_company" cookie (lib/auth/session.ts). Must be at least 32
# characters, and must be the EXACT value company/backend's own
# COMPANY_SESSION_SECRET uses — that service verifies signatures this app
# makes, it doesn't generate its own.
SESSION_SECRET=

# Signs the one-time team-invite link (lib/auth/invite-token.ts) — a
# deliberately separate secret from SESSION_SECRET (see that file).
COMPANY_INVITE_SECRET=

# This app's own public origin — used to build the invite link sent by email.
COMPANY_PORTAL_URL=http://localhost:3002

# ── Email (Resend) — team invites ───────────────────────────────────────────
# Unset means invites still work, but lib/mailer.ts can't send the email —
# the invite link is returned for you to share yourself instead.
RESEND_API_KEY=
RESEND_FROM=
NOTIFY_EMAIL=

# ── company/backend — real Stripe billing only ──────────────────────────────
# Unset means the Upgrade/Manage billing buttons on /settings/billing show an
# honest "not connected yet" message — every other screen in this app is
# unaffected (roles/candidates/team stay direct-Supabase CRUD, unchanged).
# See company/backend/README.md to run that service locally.
COMPANY_BACKEND_URL=http://localhost:8081

# ── candidate/backend — generating a task for a role ───────────────────────
# The role page's "Generate a task" calls candidate/backend, which holds the
# model and the step that runs a draft to check it. That backend must have
# COMPANY_SESSION_SECRET set to this app's SESSION_SECRET. Unset means the
# button says generation isn't connected; attaching a library task still works.
#   Local dev:  http://localhost:8080
#   Deployed:   https://mindfries-candidate-backend.up.railway.app
CANDIDATE_BACKEND_URL=
