# Mindfries company backend — the Company Portal's Application API (roles,
# candidate pipeline, team, billing). Shares one Supabase Postgres database
# with company/frontend; validates the signed session cookie that app
# issues rather than minting its own.

# Direct Postgres connection — same value as company/frontend's DATABASE_URL
# (it's the same database every app in this repo shares). Supabase dashboard
# → Project Settings → Database → Connection string → URI.
DATABASE_URL=

# ── Session verification ─────────────────────────────────────────────────────
# Must be the EXACT same value as company/frontend's own SESSION_SECRET —
# this backend verifies signatures that app makes, it does not mint its own.
# Copy it, never regenerate it here.
COMPANY_SESSION_SECRET=

# Comma-separated list of origins allowed to make credentialed requests —
# company/frontend's own origin. A cookie-carrying request needs an exact
# origin match (never "*") plus Access-Control-Allow-Credentials.
ALLOWED_ORIGINS=http://localhost:3002

# Port the HTTP server listens on. Defaults to 8081 if unset.
PORT=8081

# ── Real Stripe billing (Phase 4) ───────────────────────────────────────────
# Unset means checkout/portal/webhook handlers answer "not configured" rather
# than failing unpredictably against Stripe's API.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The plan-name to Stripe Price ID table — one Price per paid plan tier.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
