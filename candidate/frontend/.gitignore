# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Monaco editor assets — generated by scripts/copy-monaco.js (postinstall),
# self-hosted instead of loaded from a CDN. See EditorPanel.tsx.
/public/monaco-editor/

# Pyodide (Python-in-WASM runtime) — generated by scripts/copy-pyodide.js
# (postinstall). See lib/ide/pyodide-runtime.ts.
/public/pyodide/
