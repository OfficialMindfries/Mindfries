# Candidate app — shared Supabase (same project as internal-admin), server-only.
# Set in Vercel (officemindfries account). Never exposed to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Candidate sign-in ────────────────────────────────────────────────────────
# Signs the session cookie. 32+ characters; generate a fresh one per
# environment and never reuse it (and never reuse internal-admin's — these
# are separate trust domains). Missing it means nobody can sign in, which is
# the safe direction to fail.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Direct Postgres connection, for scripts/migrate.mts only — the app itself
# never uses it. Supabase dashboard → Project Settings → Database →
# Connection string → URI. Percent-encode any of @ : / ? # [ ] % in the
# password, or the URI will be misparsed. Shares one database with
# internal-admin, so schema_migrations is shared too — this script sees
# admin's migrations as already applied and only runs candidate's own.
DATABASE_URL=

# ── Candidate backend (candidate/backend — Go, System_Archetect_And_PRD.md
# §2.3) ──────────────────────────────────────────────────────────────────────
# Server-only base URL for the Application API / Assessment Orchestrator —
# see src/lib/backend/client.ts. Unset means the dashboard and assessments
# pages fall back to sample data (same supabaseReady()-style honesty as the
# rest of this app), and starting a session opens the workspace without a
# tracked session rather than pretending one exists.
#   Local dev:  http://localhost:8080
#   Deployed:   https://mindfries-candidate-backend.up.railway.app
# The backend only accepts this app's session cookie when SESSION_SECRET here
# matches its CANDIDATE_SESSION_SECRET.
CANDIDATE_BACKEND_URL=

# ── Social sign-in (see src/lib/auth/oauth-providers.ts) ────────────────────
# Each pair is one registered OAuth app; a provider only shows as a real
# button on the login page once BOTH its CLIENT_ID and CLIENT_SECRET are set
# (src/lib/auth/oauth-providers.ts's isConfigured) — an unconfigured provider
# keeps the honest "isn't connected yet" notice instead of linking anywhere.
# The redirect/callback URL to register with each provider is:
#   {this app's own origin}/api/auth/oauth/{google|github|gitlab|linkedin}/callback
#   Local dev:  http://localhost:3000/api/auth/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# ── Email to candidates ──────────────────────────────────────────────────────
# The link that confirms a new account's address, and the password-reset
# link (src/lib/auth/email-links.ts). Sent through Resend — the same account
# the company portal and internal-admin use. RESEND_FROM must be on a domain
# verified in Resend. Unset, no mail is sent: "Forgot your password?" says
# so, and the dashboard doesn't ask for a confirmation it can't send.
RESEND_API_KEY=
RESEND_FROM=
# Reply-To on those messages. Optional.
NOTIFY_EMAIL=
# This site's public address, used to build the links in those messages —
# e.g. https://candidates.mindfries.com. On Vercel the deployment's
# production address is used when this is unset; anywhere else in
# production it is required, because the links are deliberately never built
# from the request's Host header.
CANDIDATE_PORTAL_URL=

# ── Proving a linked account is yours (Composio) ─────────────────────────────
# Lets a candidate sign in to GitHub, GitLab or LinkedIn so their profile can
# say the account is theirs (src/lib/composio.ts). Composio dashboard →
# Settings → API Keys. Unset, accounts can still be linked by username and
# are shown as "ownership not confirmed".
# The sign-in returns to CANDIDATE_PORTAL_URL (above), so that must be set
# too outside Vercel.
COMPOSIO_API_KEY=
# Each platform also needs an auth config in the Composio project (dashboard
# → Auth Configs → Create, for GitHub, GitLab and LinkedIn). The app looks
# them up and never creates one; a platform without one simply isn't offered
# for sign-in. The key needs: auth_configs read, connected_accounts write,
# and tool execution.
# Optional: name the auth config to use for a platform outright, e.g. one
# backed by your own OAuth app with narrower scopes.
COMPOSIO_GITHUB_AUTH_CONFIG_ID=
COMPOSIO_GITLAB_AUTH_CONFIG_ID=
COMPOSIO_LINKEDIN_AUTH_CONFIG_ID=
