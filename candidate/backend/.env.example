# Mindfries candidate backend — Go monolith (System_Archetect_And_PRD.md §2.3,
# confirmed 2026-09-12). Shares one Supabase Postgres database with
# candidate/frontend and internal-admin/frontend; validates the same signed
# session cookies those two apps issue rather than minting its own.

# Direct Postgres connection — same value as candidate/frontend's DATABASE_URL
# (and internal-admin's; it's the same database). Supabase dashboard →
# Project Settings → Database → Connection string → URI.
DATABASE_URL=

# ── Session verification ─────────────────────────────────────────────────────
# Must be the EXACT same values as each frontend's own SESSION_SECRET — this
# backend verifies signatures those apps make, it does not mint its own.
# Copy them, never regenerate them here.
CANDIDATE_SESSION_SECRET=
ADMIN_SESSION_SECRET=

# Comma-separated list of origins allowed to make credentialed requests —
# the Next.js apps' own origins. A cookie-carrying request needs an exact
# origin match (never "*") plus Access-Control-Allow-Credentials.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Port the HTTP server listens on. Defaults to 8080 if unset.
PORT=8080

# ── AI Intelligence Layer (PRD §2.3, §1.9) ──────────────────────────────────
# OpenRouter is the single access point for every non-realtime model call
# (Code Evaluation, Reasoning, Workflow, Report agents; vision RAG). Unset
# means those agents answer "not configured" — no fabricated evidence.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-agent model overrides — all four default to the same PRD §2.4 proposal
# (Claude, via OpenRouter) until that routing is confirmed. Override
# independently once it is, or to experiment with a different model per agent.
#   OPENROUTER_MODEL_CODE_EVAL=
#   OPENROUTER_MODEL_REASONING=
#   OPENROUTER_MODEL_WORKFLOW=
#   OPENROUTER_MODEL_REPORT=

# Models for the candidate-facing agents. All default to a Gemini model
# through OpenRouter; override any one without a code change.
# OPENROUTER_MODEL_ASSISTANT=google/gemini-3.8-flash
# OPENROUTER_MODEL_INTERVIEW=google/gemini-3.8-flash
# OPENROUTER_MODEL_TASKGEN=google/gemini-3.8-flash

# ── Task generation ─────────────────────────────────────────────────────────
# Lets the Company Portal call this backend to generate a task for one of its
# own roles: the same value as company/frontend's SESSION_SECRET. Unset means
# only Mindfries' admin portal can generate tasks.
COMPANY_SESSION_SECRET=
# Where a generated task is run before it is saved, to confirm its tests
# fail as given and pass with the reference solution:
#   sandbox  a Daytona sandbox (the default when DAYTONA_API_KEY is set)
#   local    a child process on this machine — development only; it runs
#            model-written code with no isolation
#   off      don't run tasks
# With no runner, a draft is returned marked "not run".
# TASK_VERIFY=

# ── Invitations ─────────────────────────────────────────────────────────────
# An invitation is addressed to an email; an account is made by typing one
# in. With this on, an invitation can only be started from an account whose
# address is confirmed (the emailed link, or a provider sign-in). Leave it
# off until candidate/frontend can send mail (its RESEND_API_KEY) — without
# mail nobody can confirm, and every invitation would be stuck.
# candidate/frontend applies the same rule to accepting an invitation by
# itself, as soon as it can send mail.
# REQUIRE_VERIFIED_EMAIL=true

# ── Live voice interview (Gemini Live API, direct) ─────────────────────────
# The interviewer's live voice call is realtime audio, which OpenRouter
# doesn't carry, so it uses a Google AI Studio key directly. Unset means the
# interview still runs, turn by turn over OpenRouter.
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live

# ── Sandbox orchestration (PRD §2.3 — Daytona) ──────────────────────────────
# Set, every session gets a real machine: the task is put there when the
# session starts, and the workspace's terminal and files are the sandbox's
# (internal/workspace, internal/httpapi/sandbox.go). Each live session is one
# running sandbox on this Daytona account until it is submitted — that is
# the cost. Unset, or if a sandbox can't be made ready, the session runs in
# the candidate's browser instead; nothing pretends a sandbox exists.
DAYTONA_API_KEY=
DAYTONA_BASE_URL=https://app.daytona.io/api
# What a session's sandbox may reach on the network:
#   open        everything (the default). A candidate can call any outside
#               service from the terminal, unseen by the built-in assistant.
#   essentials  package registries, git hosts and the rest of Daytona's
#               "essential services"; the general web is cut off. Daytona
#               decides that list, and it includes the large AI providers'
#               APIs — this narrows the network, it does not stop an API
#               call to a model.
#   none        no network at all. pip/npm install will fail, so only for
#               tasks whose dependencies are already in the image.
# The workspace tells the candidate which of these applies.
# SANDBOX_NETWORK=open
# How many sessions may hold a sandbox at once; one more starts in the
# browser instead. 0 removes the ceiling.
# SANDBOX_MAX_LIVE=25
